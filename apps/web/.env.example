NEXT_PUBLIC_API_BASE_URL=http://localhost:9090

# Sprint 1 dev auth: when set, the login form drops a session cookie containing
# these IDs and the dashboard pulls them through to the API as X-Dev-* headers.
NEXT_PUBLIC_DEV_AUTH=true

# Clerk (V2 candidate: real publishable key once auth provider is chosen).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
